# ==============================================================================
# NETKNIFE-APP — GITIGNORE
# ==============================================================================
# frontend/.env.production is ignored (Vite secrets pattern) but this fork
# checks in local-auth values via the working tree / setup docs. Do not add
# Cognito client secrets here.

__pycache__/
*.py[cod]

.pnpm-store/

# Dependencies (never commit installed packages)
node_modules/

# Build outputs
frontend/dist/
*.zip

# Environment files (contain secrets!). API keys live in server/.env — see docs/ENV.md
.env
.env.*
!.env.example
!.env.*.example
server/.env
server/.env.*
!server/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example
!frontend/.env.*.example

# Terraform
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
.terraform/
.terraform.lock.hcl
*.tfvars
!*.tfvars.example
backend.hcl
backend.tf
*.tfplan
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/

# Temporary files
tmp/
temp/

Pentester.pdf