# Copy to server/.env (gitignored). Restart Node after edits.
# Full table: docs/ENV.md

PORT=3001

# Stub billing so the SPA unlocks remote tools. Set false only with real DynamoDB/Stripe.
LOCAL_FULL_ACCESS=true

# In-process cache (no DynamoDB). Handlers still need @aws-sdk at repo root to *load*.
LOCAL_MEMORY_CACHE=true

# Injected JWT claims — admin-gated pages check this username.
LOCAL_USERNAME=alexlux
LOCAL_EMAIL=alexlux@local
LOCAL_NAME=Alex Lux (Local)

# Optional third-party keys (same names as the original AWS Lambdas).
# Empty disables that integration; it does not crash the server.
# ABUSEIPDB_API_KEY=
# SHODAN_API_KEY=
# VIRUSTOTAL_API_KEY=
# OPENAI_API_KEY=
# NVD_API_KEY=
